
# Starter .gitignore for a git repo that tracks the whole ~/.config directory.
# Place this at the root of the repo (e.g. ~/dotfiles/config/.gitignore).
# Review and extend it for your own setup before your first commit.

# --- Caches, logs, sockets ---
*/Cache/
*/CachedData/
*/GPUCache/
*/logs/
*/log/
*.sock
*/Crashpad/
*/blob_storage/
Claude/

# --- Electron app cache/state (VS Code, Obsidian, etc.) ---
*/CachedExtensionVSIXs/
*/CachedProfilesData/
*/CachedConfigurations/
*/Code Cache/
*/DawnGraphiteCache/
*/DawnWebGPUCache/
*/Dictionaries/
*/Local Storage/
*/Session Storage/
*/Service Worker/
*/Shared Dictionary/
*/SharedStorage/
*/WebStorage/
*/IndexedDB/
*/User/globalStorage/
*/User/History/
*/User/workspaceStorage/
*/DIPS
*/DIPS-wal
*/TransportSecurity
*/Trust Tokens
*/Trust Tokens-journal
*/Cookies
*/Cookies-journal
*/Network Persistent State
*/Local State
*/Preferences
*.lock
# --- Large / regenerable app state ---
google-chrome/
chromium/
BraveSoftware/
discord/
Slack/
spotify/
obs-studio/

# --- Secrets and credentials (never commit these) ---
gh/hosts.yml
git/credentials
*token*
*credentials*
*.pem
*.key

# --- System/session-specific ---
pulse/
dconf/
ibus/
session/

# --- lockfiles you may or may not want synced ---
# nvim/lazy-lock.json    # uncomment to stop tracking plugin versions

# --- macOS ---
.DS_Store
